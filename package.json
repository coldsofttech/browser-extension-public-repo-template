{
  "name": "browser-extension-public-repo-template",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-browser extension description.",
  "license": "MIT",
  "author": "coldsofttech",
  "type": "module",
  "homepage": "https://github.com/coldsofttech/browser-extension-public-repo-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldsofttech/browser-extension-public-repo-template.git"
  },
  "bugs": {
    "url": "https://github.com/coldsofttech/browser-extension-public-repo-template/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target chrome",
    "build:edge": "node scripts/build.mjs --target edge",
    "build:chromium": "node scripts/build.mjs --target chromium",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "package": "node scripts/build.mjs --minify --zip",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "lint:ext": "web-ext lint --source-dir dist/firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0"
  }
}
